{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  },
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "MARSWALK_API"
        }
      ]
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api:app",
      "installCommand": "pip install ."
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/redoc",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
